# ============================================================================
# TEMPLATE DE PRODUÇÃO — copiar para .env no VPS e preencher os placeholders
# Deploy: php artisan migrate --force && php artisan db:seed --class=ProductionSeeder --force
#
# CONFERIDO contra todas as variáveis env() do projecto (138 no total; a maioria
# são defaults do framework que NÃO precisam de estar aqui — Redis, SQS, DynamoDB,
# Postmark, Resend, Papertrail não são usados).
#
# OBRIGATÓRIO preencher com valores reais antes de arrancar:
#   1. APP_KEY          → php artisan key:generate
#   2. DB_USERNAME / DB_PASSWORD / DB_DATABASE  → criados no CloudPanel
#   3. ADMIN_PASSWORD   → password forte do utilizador (mín. 12 chars)
#   4. MAIL_HOST / MAIL_USERNAME / MAIL_PASSWORD / MAIL_PORT → SMTP real
#
# OPCIONAL:
#   - BACKUP_CLOUD_*    → activar cópia de backup externa (ver secção Backup)
#   - ALERTS_EMAIL      → se diferente de MAIL_FROM_ADDRESS
#   - BACKUP_NOTIFICATION_EMAIL → alerta de backup falhado
#
# VERIFICAÇÃO APÓS PREENCHER:
#   php artisan config:clear && php artisan about
#   php artisan config:show backup.backup.source.destination.disks
# ============================================================================

APP_NAME="Lead Inteligente"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://csangroup.tech

APP_LOCALE=pt
APP_FALLBACK_LOCALE=pt
APP_TIMEZONE=Africa/Luanda

APP_MAINTENANCE_DRIVER=database
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

# ----------------------------------------------------------------------------
# Logs — nunca debug em produção
# ----------------------------------------------------------------------------
LOG_CHANNEL=daily
LOG_STACK=single
LOG_LEVEL=warning
LOG_DAILY_DAYS=30

# ----------------------------------------------------------------------------
# Base de dados (criada no CloudPanel)
# ----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=adg
DB_USERNAME=
DB_PASSWORD=

# ----------------------------------------------------------------------------
# Sessões / Cache / Queues — todos em BD (sem Redis)
# ----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ----------------------------------------------------------------------------
# Backup — destino externo OPCIONAL (fase.md PENDÊNCIA 4)
# BACKUP_CLOUD_DISK vazio = backup só local. Pôr "s3" para enviar cópia também
# para um fornecedor S3-compatível (Wasabi, Backblaze B2, Cloudflare R2, MinIO).
# BACKUP_NOTIFICATION_EMAIL recebe o alerta se o backup falhar (se vazio, usa
# MAIL_FROM_ADDRESS).
# ----------------------------------------------------------------------------

# BACKUP_NOTIFICATION_EMAIL=adailson@otimize.co.ao
# BACKUP_CLOUD_DISK=s3
# BACKUP_CLOUD_ENDPOINT=s3.wasabisys.com
# BACKUP_CLOUD_REGION=us-east-1
# BACKUP_CLOUD_BUCKET=adg-backups
# BACKUP_CLOUD_KEY=
# BACKUP_CLOUD_SECRET=
# BACKUP_CLOUD_PATH_STYLE=true

# ----------------------------------------------------------------------------
# Seed de produção (ProductionSeeder lê estas variáveis)
# ----------------------------------------------------------------------------
ADMIN_PASSWORD=
ALERTS_EMAIL=adailson@otimize.co.ao

# ----------------------------------------------------------------------------
# SMTP — obrigatório para alertas e lembretes de agenda
# (ex.: Hostinger/SMTP2GO/Zoho — preencher com credenciais reais)
# ----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=adailson@otimize.co.ao
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
